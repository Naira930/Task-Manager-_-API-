# Copy this file to .env and adjust the values for your machine
# copy .env.example .env

# Connection details for your local PostgreSQL database
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:0000/task_manager

# Secret key used to sign JWTs — should be long and random, never shared
# Generate one with this command in your terminal and paste the result here:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_GENERATED_SECRET

# Port the server will run on locally
PORT=3000

# The frontend origin allowed to call this API (CORS)
FRONTEND_ORIGIN=http://localhost:3000
